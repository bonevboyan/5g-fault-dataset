 	c.ulNASTransport = msg
 }
 
+// TakeULNASTransport returns the stored UL NAS Transport and clears it in one step.
+// [f5g patch] A duplicate-PSI initial request is stored while the old session is released.
+// Two paths can finish that release (the SMF's SmContextStatusNotify, or a failed Update when
+// the SMF had released it already); exactly one of them must re-process the stored request.
+func (c *SmContext) TakeULNASTransport() *message.ULNASTransport {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	m := c.ulNASTransport
+	c.ulNASTransport = nil
+	return m
+}
