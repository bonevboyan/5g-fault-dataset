@@ -39,6 +41,20 @@ func Dispatch(conn net.Conn, msg []byte) {
 		logger.NgapLog.Error("NGAP Message is nil")
 		return
 	}
+	// [f5g patch] one root span per NGAP message: every SBI call the AMF makes while handling it
+	// (and, via f5gtrace, the calls those NFs make in turn) becomes part of this trace.
+	span := f5gtrace.Start("ngap "+reflect.TypeOf(decoded).Elem().Name(),
+		attribute.String("ran.addr", conn.RemoteAddr().String()))
+	defer span(nil)
+	if amfID, ranID := messageUEIDs(decoded); amfID != nil || ranID != nil {
+		if amfID != nil {
+			f5gtrace.Annotate(attribute.Int64("ngap.amf_ue_ngap_id", amfID.Value))
+		}
+		if ranID != nil {
+			f5gtrace.Annotate(attribute.Int64("ngap.ran_ue_ngap_id", ranID.Value))
+		}
+	}
+
 	ran, ok := amfSelf.AmfRanFindByConn(conn)
 	if !ok {
 		_, isNGSetup := decoded.(*ngapMessage.NGSetupRequest)
