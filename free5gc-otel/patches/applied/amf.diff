+// DeleteSmContextIfCurrent deletes the SmContext of pduSessionID only if it is still smContext.
+// [f5g patch] used on the duplicate-PSI path, where the SMF's status notify may already have
+// removed the old context and stored a new one under the same PSI.
+func (ue *AmfUe) DeleteSmContextIfCurrent(pduSessionID int32, smContext *SmContext) bool {
+	if !ue.SmContextList.CompareAndDelete(pduSessionID, smContext) {
+		return false
+	}
+	business_metrics.IncrPduSessionEventCounter(string(smContext.AccessType()), business_metrics.PDU_SESSION_RELEASE_EVENT)
+	return true
+}
