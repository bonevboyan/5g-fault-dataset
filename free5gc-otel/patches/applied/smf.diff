@@ -1,6 +1,8 @@
 package pfcp
 
 import (
+	"github.com/free5gc/f5gtrace"
+	"go.opentelemetry.io/otel/attribute"
 	"net"
 	"runtime/debug"
 	"sync"
@@ -155,6 +157,17 @@ func (s *PfcpServer) dispatchReceived(received RcvPfcpMsg) {
 		}
 	}()
 
+	// [f5g patch] a root span for a Session Report that carries downlink data: it triggers
+	// paging via N1N2MessageTransfer to the AMF, so the SBI calls become its children. Usage
+	// reports and other PFCP messages make no SBI calls and would only add single-span traces.
+	if rep, ok := received.Msg.(*message.SessionReportRequest); ok && rep.ReportType != nil && rep.ReportType.HasDLDR() {
+		span := f5gtrace.Start("pfcp "+received.Msg.MessageTypeName(),
+			attribute.String("upf.addr", received.RemoteAddr.String()),
+			attribute.Int64("pfcp.seid", int64(received.Msg.SEID())),
+			attribute.String("pfcp.report", "DLDR"))
+		defer span(nil)
+	}
+
 	// Synchronous execution is intentional: spawning here would turn blocked
 	// handlers into an unbounded goroutine backlog.
 	dispatch(received.Msg, &received.RemoteAddr)
